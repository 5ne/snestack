# fstack configuration
# Copy to .env and fill in your values

# Required
FSTACK_FINNHUB_API_KEY=your_finnhub_api_key
FSTACK_CLAUDE_API_KEY=sk-ant-your_claude_api_key

# Email notifications
FSTACK_GMAIL_ADDRESS=you@gmail.com
FSTACK_GMAIL_APP_PASSWORD=your_gmail_app_password
FSTACK_NOTIFICATION_EMAIL=recipient@example.com

# Optional: SMS via Twilio
FSTACK_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FSTACK_TWILIO_AUTH_TOKEN=your_twilio_auth_token
FSTACK_SMS_PHONE=+1234567890

# Database path — lives outside the repo in the shared Google Drive folder
FSTACK_DATABASE_PATH=$HOME/Documents/personal-brain/financial/fstack.db

# Google Calendar (calendar domain) — see node/README.md for how to create
# the OAuth "Desktop app" client. FSTACK_GOOGLE_REFRESH_TOKEN is written for
# you by `fstack calendar auth`, not something you set by hand.
FSTACK_GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
FSTACK_GOOGLE_CLIENT_SECRET=your_oauth_client_secret
FSTACK_GOOGLE_REFRESH_TOKEN=
