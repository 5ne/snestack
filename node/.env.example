# snestack configuration
# Copy to .env and fill in your values

# Required
SNESTACK_FINNHUB_API_KEY=your_finnhub_api_key

# Optional — historical daily closes for RSI/50MA/200MA, since Finnhub's free
# tier blocks /stock/candle. Free key at twelvedata.com. Falls back to
# Finnhub-only (no RSI/MA) if unset.
SNESTACK_TWELVEDATA_API_KEY=your_twelvedata_api_key
SNESTACK_CLAUDE_API_KEY=sk-ant-your_claude_api_key
# Optional — concrete model behind each cost tier. Skills pick a tier via their
# frontmatter `model:` (cheap | normal | expensive, default normal); code passes
# a tier to runPrompt(). Defaults shown.
# SNESTACK_MODEL_CHEAP=claude-haiku-4-5-20251001
# SNESTACK_MODEL_NORMAL=claude-sonnet-5-5
# SNESTACK_MODEL_EXPENSIVE=claude-opus-5-5

# Email notifications
SNESTACK_GMAIL_ADDRESS=you@gmail.com
SNESTACK_GMAIL_APP_PASSWORD=your_gmail_app_password
SNESTACK_NOTIFICATION_EMAIL=recipient@example.com

# Optional: SMS via Twilio
SNESTACK_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SNESTACK_TWILIO_AUTH_TOKEN=your_twilio_auth_token
SNESTACK_SMS_PHONE=+1234567890

# Postgres (Supabase) connection string for the financial db. Secret: lives only
# in this gitignored .env. Use the pooler string if this machine is IPv4-only.
SNESTACK_DATABASE_URL=

# Root of the shared Google Drive-synced folder — outside the repo. Every
# domain's brain/reports/db lives under here (e.g. financial/brain/,
# financial/reports/). One directory setting for all
# of it — nothing else derives its own separate path.
SNESTACK_BRAIN_ROOT=$HOME/Documents/personal-brain

# Google Calendar (calendar domain) — see node/README.md for how to create
# the OAuth "Desktop app" client. SNESTACK_GOOGLE_REFRESH_TOKEN is written for
# you by `snestack calendar auth`, not something you set by hand.
SNESTACK_GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
SNESTACK_GOOGLE_CLIENT_SECRET=your_oauth_client_secret
SNESTACK_GOOGLE_REFRESH_TOKEN=

# Ordered model-call backend chain: "<step>><step>>...>fail"
# Steps:
#   agy-cli    — Google Antigravity CLI (`agy -p`) on your Google AI Pro / Ultra OAuth login ($0 metered spend)
#   claude-cli — Claude Code CLI (`claude -p`) on your Claude subscription ($0 metered spend)
#   claude-api — Metered Anthropic API (requires SNESTACK_CLAUDE_API_KEY; alias: "api")
#   fail       — Stop and fail gracefully without calling another backend
# Examples:
#   SNESTACK_EXECUTOR=agy-cli>fail
#   SNESTACK_EXECUTOR=agy-cli>claude-cli>fail
#   SNESTACK_EXECUTOR=agy-cli>claude-cli>claude-api>fail
SNESTACK_EXECUTOR=agy-cli>fail

# Optional per-tier model overrides for `agy --model` (see `agy models`; unset uses your Pro/Ultra session's default model)
# SNESTACK_AGY_MODEL_CHEAP=
# SNESTACK_AGY_MODEL_NORMAL=
# SNESTACK_AGY_MODEL_EXPENSIVE=

# Subscription token from `claude setup-token` (required only when `claude-cli` is in SNESTACK_EXECUTOR)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-your_setup_token
